# Entity: historical

main: kit: entity: historical: {

  alias: field: {}

  fields: {
    country: {
      h: "Country"
      n: "country"
      r: false
      sh: "Country name"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    province: {
      h: "Province"
      n: "province"
      r: false
      sh: "List of provinces/states if applicable"
      t: "`$ARRAY`"
    }
    timeline: {
      h: "Timeline"
      n: "timeline"
      r: false
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "historical"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /historical/{country}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "USA"
                k: "param"
                n: "id"
                or: "country"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "all"
                k: "query"
                n: "lastday"
                or: "lastday"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/historical/{country}"
          q: {
            exist: [
              "id"
              "lastday"
            ]
          }
          r: {
            param: {
              country: "id"
            }
          }
          s: [
            {
              lit: "historical"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

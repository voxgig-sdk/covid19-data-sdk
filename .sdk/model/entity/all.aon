# Entity: all

main: kit: entity: all: {

  alias: field: {}

  fields: [
    {
      name: "cases"
      req: false
      short: "Historical cases data with dates as keys and case counts as values"
      type: "`$OBJECT`"
    }
    {
      name: "deaths"
      req: false
      short: "Historical deaths data with dates as keys and death counts as values"
      type: "`$OBJECT`"
    }
    {
      name: "recovered"
      req: false
      short: "Historical recovered data with dates as keys and recovery counts as values"
      type: "`$OBJECT`"
    }
  ]

  name: "all"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "all"
                kind: "query"
                name: "lastday"
                orig: "lastday"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/historical/all"
          segments: [
            {
              lit: "historical"
            }
            {
              lit: "all"
            }
          ]
          select: {
            exist: [
              "lastday"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
